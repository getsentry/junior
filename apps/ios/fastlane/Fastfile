# Signed Release builds of Junior for iOS. CI runs `ios beta` from
# .github/workflows/ios-beta.yml.
#
# Before the first beta, io.sentry.junior needs an app in App Store Connect
# and a profile in the match repo: run `bundle exec fastlane ios
# create_signing` once, with the workflow's environment.

require "json"
require "tmpdir"
require "yaml"

BUNDLE_ID = "io.sentry.junior"
TEAM_ID = "97JCY7859U"
PROFILE = "match AppStore #{BUNDLE_ID}"

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64")),
    duration: 1200,
    in_house: false
  )
end

IOS_DIR = File.expand_path("..", __dir__)

# Earlier betas with their "What to Test" notes. TestFlight is the record of
# what shipped, because a beta commits nothing. The list includes expired builds.
def testflight_history
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id, includes: "preReleaseVersion,betaBuildLocalizations", limit: 200
  )
  history = builds.map do |build|
    notes = (build.beta_build_localizations || []).map(&:whats_new).find { |text| !text.to_s.empty? }
    { version: build.app_version, build: build.version.to_i, date: build.uploaded_date.to_s[0, 10], notes: notes.to_s }
  end
  # Logged to show whether expired builds keep their notes.
  noted = builds.zip(history).reject { |_, entry| entry[:notes].empty? }
  UI.message("TestFlight: #{builds.size} builds, #{noted.size} with notes, #{noted.count { |b, _| b.expired }} of those expired")
  history
end

# Version this build from [Unreleased] in CHANGELOG.md and the TestFlight
# history (Packages/JuniorKit/Sources/junior-changelog). It rewrites
# CHANGELOG.md in this checkout only, and returns the version and the notes.
def prepare_changelog(build)
  Dir.mktmpdir do |dir|
    history = File.join(dir, "history.json")
    result = File.join(dir, "result.json")
    File.write(history, JSON.generate(testflight_history))
    base_version = YAML.load_file(File.join(IOS_DIR, "project.yml")).dig("settings", "base", "MARKETING_VERSION")
    sh(
      "swift", "run", "--package-path", File.join(IOS_DIR, "Packages/JuniorKit"), "junior-changelog", "prepare",
      File.join(IOS_DIR, "CHANGELOG.md"), history, build.to_s, base_version, result
    )
    JSON.parse(File.read(result))
  end
end

platform :ios do
  desc "Build a signed Release and upload it to TestFlight"
  lane :beta do
    setup_ci
    key = api_key
    match(type: "appstore", api_key: key)

    # TestFlight owns the build number and the record of what shipped, so a
    # beta commits no version bump and no changelog change.
    build = latest_testflight_build_number(api_key: key, initial_build_number: 0) + 1
    release = prepare_changelog(build)
    UI.message("Junior #{release["version"]} (#{build})")

    # `sh` runs in fastlane/; the project is generated and not committed.
    sh("make -C .. xcodegen")
    # Signing.xcconfig signs with the development profile. Release uses this one.
    update_code_signing_settings(
      path: "Junior.xcodeproj",
      targets: ["Junior"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE
    )

    build_app(
      project: "Junior.xcodeproj",
      scheme: "Junior",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      xcodebuild_formatter: "xcbeautify",
      xcargs: "CURRENT_PROJECT_VERSION=#{build} MARKETING_VERSION=#{release["version"]}",
      export_options: { provisioningProfiles: { BUNDLE_ID => PROFILE } }
    )

    upload_to_testflight(
      api_key: key,
      # With notes, it waits until the build shows in App Store Connect to set them.
      changelog: release["notes"].empty? ? nil : release["notes"],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Create the certificates and profiles in the match repo. Run once, by hand."
  lane :create_signing do
    key = api_key
    match(type: "appstore", readonly: false, api_key: key)
    # The development profile holds the devices registered to the team when it
    # is made. After you register a device, run this lane again.
    match(type: "development", readonly: false, force_for_new_devices: true, api_key: key)
  end
end
