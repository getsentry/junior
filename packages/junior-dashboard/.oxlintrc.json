{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "jsPlugins": [
    "@tanstack/eslint-plugin-query",
    {
      "name": "anti-slop",
      "specifier": "../../tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "junior",
      "specifier": "../../tools/oxlint/junior/index.ts"
    },
    {
      "name": "display-text",
      "specifier": "./oxlint/display-text.ts"
    },
    {
      "name": "text-control",
      "specifier": "./oxlint/text-control.ts"
    }
  ],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "rules": {
    "junior/zod-namespace-import": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/infinite-query-property-order": "error",
    "@tanstack/query/mutation-property-order": "error",
    "@tanstack/query/no-rest-destructuring": "error",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/query/no-void-query-fn": "error",
    "@tanstack/query/stable-query-client": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "display-text/no-raw-display-text": "error",
    "text-control/no-raw-text-control": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@sentry/browser",
            "importNames": ["init"],
            "message": "init() bundles every default integration. Build a BrowserClient, as in client/sentry.ts."
          }
        ],
        "patterns": [
          {
            "group": [
              "react-markdown",
              "remark-*",
              "rehype-*",
              "emojibase-data",
              "emojibase-data/*"
            ],
            "message": "Render Markdown and emoji only through client/display-text/DisplayText."
          },
          {
            "group": [
              "**/display-text/*",
              "!**/display-text/DisplayText",
              "!**/display-text/plainText"
            ],
            "message": "Import only DisplayText or displayPlainText from client/display-text."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/client/components/ui/**"],
      "rules": {
        "text-control/no-raw-text-control": "off"
      }
    },
    {
      "files": ["src/client/display-text/**"],
      "rules": {
        "display-text/no-raw-display-text": "off",
        "no-restricted-imports": "off"
      }
    }
  ]
}
