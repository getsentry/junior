{
  "name": "@sentry/junior-dashboard",
  "version": "0.267.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/junior.git",
    "directory": "packages/junior-dashboard"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @sentry/junior-plugin-api build && pnpm --filter @sentry/junior build && pnpm run build:client && pnpm run build:css && pnpm run build:server",
    "build:client": "tsup --config tsup.client.config.ts",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/tailwind.css --minify",
    "build:server": "tsup --config tsup.config.ts && tsdown --config tsdown.dts.config.ts",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run -c vitest.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/results.junit.xml"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/junior-plugin-api": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "@uidotdev/usehooks": "2.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.11",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "recharts": "3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.1.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@sentry/junior": "workspace:*"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@sentry/junior": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.8.0",
    "nitro": "3.0.260522-beta",
    "oxlint": "^1.79.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "0.23.1",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
