{
  "name": "@sentry/junior-memory",
  "version": "0.222.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/junior.git",
    "directory": "packages/junior-memory"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint --config ../junior/.oxlintrc.json --deny-warnings src tsup.config.ts",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/junior-plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@sentry/junior": "workspace:*",
    "@types/node": "^25.9.1",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "description": "Compatibility shim; Memory now ships inside @sentry/junior",
  "peerDependencies": {
    "@sentry/junior": "workspace:*"
  }
}
