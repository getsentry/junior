{
  "name": "@sentry/junior-memory",
  "version": "0.268.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/junior.git",
    "directory": "packages/junior-memory"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsdown",
    "db:generate": "pnpm exec drizzle-kit generate --config drizzle.config.ts",
    "lint": "oxlint --config ../junior/.oxlintrc.json --deny-warnings src tests tsdown.config.ts",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/junior-plugin-api": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "commander": "^14.0.3",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@sentry/junior-testing": "workspace:*",
    "@types/node": "^25.9.1",
    "drizzle-kit": "catalog:",
    "oxlint": "^1.79.0",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
