{
  "name": "@sentry/junior",
  "version": "0.197.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/app.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/junior.git",
    "directory": "packages/junior"
  },
  "bin": {
    "junior": "bin/junior.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "default": "./dist/instrumentation.js"
    },
    "./nitro": {
      "types": "./dist/nitro.d.ts",
      "default": "./dist/nitro.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./api/schema": {
      "types": "./dist/api/schema.d.ts",
      "default": "./dist/api/schema.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "migrations",
    "skills"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "acp:smoke": "pnpm exec tsx scripts/acp-smoke.ts",
    "db:generate": "pnpm exec drizzle-kit generate --config drizzle.config.ts",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src tests scripts bin tsup.config.ts && depcruise --config .dependency-cruiser.mjs src/chat",
    "lint:fix": "oxlint --config .oxlintrc.json --deny-warnings --fix src tests scripts bin tsup.config.ts",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "skills:check": "node --test scripts/check-skills.test.mjs && node scripts/check-skills.mjs",
    "tool-annotations:check": "node --test scripts/check-tool-annotations.test.mjs && node scripts/check-tool-annotations.mjs",
    "tool-error-classification:check": "node --test scripts/check-tool-error-classification.test.mjs && node scripts/check-tool-error-classification.mjs",
    "test:coverage": "vitest run --maxWorkers=4 --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/results.junit.xml"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@ai-sdk/gateway": "^3.0.119",
    "@chat-adapter/slack": "4.29.0",
    "@chat-adapter/state-memory": "4.29.0",
    "@chat-adapter/state-redis": "4.29.0",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@hono/zod-validator": "^0.9.0",
    "@logtape/logtape": "^2.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@sentry/junior-plugin-api": "workspace:*",
    "@sentry/node": "catalog:",
    "@sinclair/typebox": "^0.34.49",
    "@slack/web-api": "^7.16.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.6.0",
    "@vercel/oidc": "^3.4.1",
    "@vercel/queue": "^0.2.0",
    "@vercel/sandbox": "2.8.0",
    "ai": "^6.0.190",
    "chat": "4.29.0",
    "commander": "^14.0.3",
    "drizzle-orm": "catalog:",
    "hono": "^4.12.27",
    "jiti": "^2.7.0",
    "jose": "^6.2.3",
    "just-bash": "3.0.1",
    "node-html-markdown": "^2.0.0",
    "pg": "^8.16.3",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@hono/node-server": "1.19.14",
    "@oxlint/plugins": "1.79.0",
    "@sentry/junior-github": "workspace:*",
    "@sentry/junior-memory": "workspace:*",
    "@sentry/junior-testing": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "4.1.7",
    "dependency-cruiser": "^17.4.0",
    "drizzle-kit": "catalog:",
    "msw": "^2.14.6",
    "nitro": "3.0.260522-beta",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vercel": "^54.4.0",
    "vitest": "^4.1.7"
  }
}
