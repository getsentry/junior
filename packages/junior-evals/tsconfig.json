{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Exception to the strict base: the .d.ts files of drizzle-orm, just-bash, and other packages/junior dependencies
    // fail type checks (for example, drizzle-orm imports optional drivers
    // such as `gel` that are not installed). Remove this line when
    // `tsc --noEmit -p . --skipLibCheck false` passes.
    "skipLibCheck": true,
    // Temporary exception: 164 errors remain under exactOptionalPropertyTypes
    // (122 in packages/junior, 42 in packages/junior-dashboard). Count them
    // with `tsc --noEmit -p . --exactOptionalPropertyTypes`. Remove this line
    // when that command passes.
    "exactOptionalPropertyTypes": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../junior/src/*"],
      "@junior-evals/fixture/*": ["./src/fixture/*"],
      "@junior-tests/*": ["../junior/tests/*"],
      "@sentry/junior": ["../junior/src/app.ts"],
      "@sentry/junior-memory": ["../junior-memory/src/index.ts"],
      "@sentry/junior-plugin-api": ["../junior-plugin-api/src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "evals/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "../junior/src/virtual-modules.d.ts"
  ]
}
