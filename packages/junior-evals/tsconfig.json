{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../junior/src/*"],
      "@junior-evals/fixture/*": ["./src/fixture/*"],
      "@junior-tests/*": ["../junior/tests/*"],
      "@sentry/junior": ["../junior/src/app.ts"],
      "@sentry/junior-memory": ["../junior-memory/src/index.ts"],
      "@sentry/junior-plugin-api": ["../junior-plugin-api/src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "evals/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "../junior/src/virtual-modules.d.ts"
  ]
}
