        {
          "id": "shared-filter",
          "label": "The shared filter",
          "caption": "One new function holds the two conditions that decide whether a list may show a Conversation.",
          "body": "`listedConversation()` matches a Conversation that has no parent and is not an unkept Quick question [1]. Its doc comment sets the limits: each caller still adds its own access and scope filters, and structural root checks such as retention do not use it. The PR body says this is groundwork, so a later hidden kind, such as Walkthrough generation Conversations, needs a change in one place only.",
          "view": {
            "pr": 3071,
            "show": ["listed"],
            "highlight": ["listed"],
            "added": ["listed"],
            "broken": []
          },
          "evidence": [
            {
              "kind": "code",
