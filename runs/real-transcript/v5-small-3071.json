   "chapters": [
    {
     "id": "opening",
     "label": "One rule, five copies",
     "caption": "Five list and search queries each wrote the same two-condition filter by hand; now they call one predicate.",
     "role": "opening",
     "body": "Every place that lists Conversations to people or agents must hide child Conversations and unkept Quick questions (private side threads forked from a Reply). Before this PR, five queries in four files wrote that rule by hand, each with a copied comment. The upcoming Walkthrough work needs to hide its generation Conversations too, and with five copies one would be missed [1]. This PR keeps behavior the same and moves the rule into one predicate that all five call. The review risk is small: confirm each site lost exactly those two conditions and nothing else.",
     "view": {
      "pr": 3071,
      "show": [
       "listed",
       "feed-rows",
       "feed-token",
       "board",
       "brief-search",
       "agent-search",
