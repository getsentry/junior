    },
    {
     "id": "call-sites",
     "label": "Same conditions at each site",
     "caption": "Each call site swaps the two removed conditions for the predicate and keeps its other filters.",
     "role": "other",
     "body": "In the feed query, the two lines and their comment become one call; membership, status and search filters stay [1][2]. Agent top-level search keeps its root-equals-self, purge and public checks around the call [3]. The Board does the same, and its archived and activity-window checks stay. In the Board the predicate now comes before the archived check, which only changes the order inside an AND. Postgres ignores that order.",
     "evidence": [
      {
       "kind": "code",
       "pr": 3071,
       "path": "packages/junior/src/api/conversations/list.ts",
