{
  "name": "junior-monorepo",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "acp:local": "node scripts/acp-local.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:env": "pnpx vercel env pull .env.local --environment=development && pnpm run cloudflare:token",
    "cli": "node scripts/cli-with-root-env.mjs",
    "worktree": "node scripts/worktree.mjs",
    "worktree:new": "node scripts/worktree.mjs new",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:setup": "node scripts/worktree.mjs setup",
    "cloudflare:token": "node scripts/refresh-cloudflare-tunnel-token.mjs",
    "prepare": "simple-git-hooks",
    "lint": "node scripts/check.mjs && pnpm oxlint-rules:check && pnpm --filter @sentry/junior tool-annotations:check && pnpm --filter @sentry/junior tool-key-casing:check && pnpm --filter @sentry/junior tool-descriptions:check && pnpm --filter @sentry/junior tool-error-classification:check && oxlint && pnpm --filter @sentry/junior deps:check && pnpm ast-grep:lint && pnpm package:lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "baseline-growth:check": "node scripts/check.mjs baseline-growth",
    "file-length:check": "node scripts/check.mjs file-length",
    "migration-metadata:check": "node scripts/check.mjs drizzle-migrations",
    "migration-locks:check": "node scripts/check.mjs migration-locks",
    "money-units:check": "node scripts/check.mjs money-units",
    "provider-state:check": "node scripts/check.mjs provider-state",
    "reply-rendering:check": "node scripts/check.mjs reply-rendering",
    "lockfile-families:check": "node scripts/check.mjs lockfile-families",
    "path-case:check": "node scripts/check.mjs path-case",
    "oxlint-rules:check": "node --test tools/oxlint/junior/rules/*.test.ts packages/junior-dashboard/oxlint/*.test.ts",
    "test-architecture:check": "node scripts/check.mjs test-architecture",
    "type-assertions:check": "node scripts/check.mjs type-assertions",
    "await-in-loop:check": "node scripts/check.mjs await-in-loop",
    "nav-request-budgets:check": "node scripts/check.mjs nav-request-budgets",
    "dashboard-style:check": "node scripts/check.mjs dashboard-styles",
    "dashboard-bundle-size:check": "node scripts/check.mjs dashboard-bundle-size",
    "ast-grep:lint": "ast-grep test --test-dir ast-grep/tests --skip-snapshot-tests && ast-grep scan --error=unused-suppression --error=no-suppress-all && node scripts/check.mjs ast-grep-ignores",
    "lint-staged": "lint-staged",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"!@sentry/junior-docs\" run build",
    "build:example": "pnpm --filter @sentry/junior-example build",
    "docs:dev": "pnpm --filter @sentry/junior-docs dev",
    "docs:build": "pnpm --filter @sentry/junior-docs build",
    "docs:check": "pnpm --filter @sentry/junior-docs check",
    "package:lint": "for pkg in packages/junior packages/junior-plugin-api packages/junior-dashboard packages/junior-github packages/junior-google packages/junior-agent-browser packages/junior-amplitude packages/junior-cloudflare packages/junior-datadog packages/junior-figma packages/junior-tts packages/junior-hex packages/junior-linear packages/junior-maintenance packages/junior-notion packages/junior-octolens packages/junior-pagerduty packages/junior-restream packages/junior-sentry packages/junior-vercel packages/junior-vimeo packages/junior-xdotcom; do pnpm exec publint \"$pkg\" || exit $?; done",
    "package-types:check": "node scripts/check.mjs package-types",
    "prompt-tokens": "node scripts/prompt-tokens.mjs",
    "release:check": "node scripts/check.mjs release-config",
    "start": "pnpm --filter @sentry/junior-example dev",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" --filter \"!@sentry/junior-docs\" --filter \"!@sentry/junior-evals\" run test",
    "test:e2e:dashboard": "pnpm --filter \"@sentry/junior-dashboard...\" run build && playwright test -c packages/junior-dashboard/playwright.config.ts",
    "test:watch": "pnpm --filter @sentry/junior test:watch",
    "evals": "pnpm --filter @sentry/junior-evals evals",
    "evals:behavioral": "pnpm --filter @sentry/junior-evals evals:behavioral",
    "evals:integration": "pnpm --filter @sentry/junior-evals evals:integration",
    "evals:guardian": "pnpm --filter @sentry/junior-evals evals:guardian",
    "evals:record": "pnpm --filter @sentry/junior-evals evals:record",
    "typecheck-coverage:check": "node scripts/check.mjs typecheck-coverage",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tools/oxlint && tsc --noEmit -p tools/configs",
    "skills:check": "pnpm --filter @sentry/junior skills:check",
    "plugin-package-content:check": "node scripts/check.mjs plugin-package-content"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix",
    "*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml}": [
      "pnpm file-length:check",
      "pnpm test-architecture:check",
      "pnpm dashboard-style:check",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@ast-grep/cli": "^0.43.0",
    "@octokit/graphql-schema": "^15.26.1",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "^1.60.0",
    "@primer/octicons": "19.21.1",
    "@types/node": "catalog:",
    "agent-browser": "^0.27.0",
    "libpg-query": "18.2.2",
    "lint-staged": "^17.0.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "p-limit": "catalog:",
    "publint": "^0.3.21",
    "sentry": "0.47.0",
    "simple-git-hooks": "^2.13.1",
    "squawk-cli": "2.72.0",
    "tsx": "^4.22.3",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
