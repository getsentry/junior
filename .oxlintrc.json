{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./tools/oxlint/type-aware.json"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "vitest"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "junior",
      "specifier": "./tools/oxlint/junior/index.ts"
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vercel/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.astro/**",
    ".playwright/**",
    "test-results/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "packages/junior-evals/fixtures/**"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@earendil-works/pi-ai",
            "importNames": [
              "completeSimple",
              "getEnvApiKey",
              "getModels",
              "registerApiProvider"
            ],
            "message": "Use @/chat/pi/client so provider calls stay traced and gateway auth stays centralized."
          },
          {
            "name": "@earendil-works/pi-ai/compat",
            "importNames": [
              "completeSimple",
              "getEnvApiKey",
              "getModels",
              "registerApiProvider"
            ],
            "message": "Use @/chat/pi/client so provider calls stay traced and gateway auth stays centralized."
          },
          {
            "name": "@/chat/pi/sdk",
            "importNames": [
              "completeSimple",
              "getEnvApiKey",
              "getModels",
              "registerApiProvider"
            ],
            "message": "Use @/chat/pi/client so provider calls stay traced and gateway auth stays centralized."
          },
          {
            "name": "@earendil-works/pi-ai/api/anthropic-messages",
            "message": "Register anthropic providers only in @/chat/pi/client."
          }
        ]
      }
    ],
    "unicorn/no-useless-fallback-in-spread": "off",
    "vitest/expect-expect": "off",
    "vitest/hoisted-apis-on-top": "off",
    "vitest/require-mock-type-parameters": "off",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "junior/zod-namespace-import": "error"
  },
  "overrides": [
    {
      "files": ["packages/junior/src/**/*.ts"],
      "rules": {
        "junior/touch-conversation-detail": "error"
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "junior/no-raw-sql-queries": "error",
        "junior/no-regex-url-parsing": "error"
      }
    },
    {
      "files": ["packages/junior-github/src/**/*.ts"],
      "rules": {
        "junior/github-graphql-schema": "error",
        "junior/use-github-api": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/credential-support.js"],
                "importNames": ["githubRequest", "issueInstallationToken"],
                "message": "Read and write GitHub through host egress with githubApi, so egress policy, grant selection, the shared credential lease, and egress audit logs apply. Only webhook handling in src/webhooks/ may call GitHub directly."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Read and write GitHub through host egress with githubApi, so egress policy, grant selection, the shared credential lease, and egress audit logs apply. Only src/credential-support.ts may call fetch."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Read and write GitHub through host egress with githubApi, so egress policy, grant selection, the shared credential lease, and egress audit logs apply. Only src/credential-support.ts may call fetch."
          }
        ]
      }
    },
    {
      "files": [
        "packages/junior-github/src/webhooks/**/*.ts",
        "packages/junior-github/src/credential-support.ts",
        "packages/junior-github/src/default-branch.ts",
        "packages/junior-github/src/github-status.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["packages/junior-github/src/tool-support/github-api.ts"],
      "rules": {
        "junior/use-github-api": "off"
      }
    },
    {
      "files": [
        "packages/junior/src/chat/pi/client.ts",
        "packages/junior/src/chat/pi/gateway-auth.ts",
        "packages/junior/src/chat/pi/sdk.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "packages/junior/tests/component/**",
        "packages/junior/tests/integration/**"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "error"
      }
    },
    {
      "files": [
        "packages/junior/tests/component/workspace-tools.test.ts",
        "packages/junior/tests/component/plugins/plugin-registry-packages.test.ts",
        "packages/junior/tests/component/sandbox/snapshot/resolve.test.ts",
        "packages/junior/tests/component/runtime/agent-run-mcp-progressive-loading.test.ts",
        "packages/junior/tests/component/runtime/agent-run-sandbox.test.ts",
        "packages/junior/tests/component/briefs/conversation-brief-task.test.ts",
        "packages/junior/tests/component/memory-plugin-storage.test.ts",
        "packages/junior/tests/component/plugins/plugin-registry.test.ts",
        "packages/junior/tests/component/task-execution/conversation-index-redis.test.ts",
        "packages/junior/tests/component/handlers/sandbox-egress-proxy.test.ts",
        "packages/junior/tests/component/config/chat-config.test.ts",
        "packages/junior/tests/component/skills-plugin-provider.test.ts",
        "packages/junior/tests/component/cli/chat-cli.test.ts",
        "packages/junior/tests/component/runtime/agent-run-agent-continue.test.ts",
        "packages/junior/tests/component/cli/local-chat-composition.test.ts",
        "packages/junior/tests/component/plugins/notion-plugin.test.ts",
        "packages/junior/tests/component/runtime/agent-run-provider-retry.test.ts",
        "packages/junior/tests/component/runtime/agent-run-error-path.test.ts",
        "packages/junior/tests/component/misc/sandbox-executor.test.ts",
        "packages/junior/tests/component/tools/load-skill.test.ts",
        "packages/junior/tests/component/task-execution/checkpoint.test.ts",
        "packages/junior/tests/component/plugins/amplitude-plugin.test.ts",
        "packages/junior/tests/component/slack/footer-sentry-link.test.ts",
        "packages/junior/tests/component/tool-support/pi-tool-adapter.test.ts",
        "packages/junior/tests/component/runtime/agent-run-tool-timeout-continuation.test.ts",
        "packages/junior/tests/component/app-sandbox-trace-config.test.ts",
        "packages/junior/tests/component/plugins/plugin-run-actors.test.ts",
        "packages/junior/tests/component/vercel-queue-dev.test.ts",
        "packages/junior/tests/component/slack/inbound-telemetry.test.ts",
        "packages/junior/tests/component/agent/sandbox.test.ts",
        "packages/junior/tests/component/plugins/plugin-prompt-hooks.test.ts",
        "packages/junior/tests/component/sandbox/snapshot/workspace.test.ts"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    },
    {
      "files": [
        "**/tests/**",
        "**/*.test.ts",
        "packages/junior-evals/**",
        "packages/junior-testing/**"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-misused-promises": [
          "error",
          {
            "checksVoidReturn": false
          }
        ],
        "typescript/require-array-sort-compare": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": [
        "packages/junior-evals/evals/**",
        "packages/junior-evals/**/*.eval.ts",
        "packages/junior-evals/tests/component/eval-work.test.ts"
      ],
      "rules": {
        "vitest/no-standalone-expect": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["**/*.js", "**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-implied-eval": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    {
      "files": ["packages/junior-evals/**", "packages/junior-testing/**"],
      "rules": {
        "junior/no-raw-sql-queries": "off",
        "junior/no-regex-url-parsing": "off"
      }
    }
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  }
}
